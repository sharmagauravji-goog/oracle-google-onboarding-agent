# Generated by Oracle Database@Google Cloud Onboarding & Infrastructure Agent
# Target Project: {{ phase1.project_id }} | Region: {{ phase1.region }} | Environment: {{ phase1.environment }}

serviceAccount: "projects/{{ phase1.project_id }}/serviceAccounts/{{ phase4.terraform_service_account }}"
options:
  logging: CLOUD_LOGGING_ONLY

substitutions:
  _TF_VERSION: "1.8.5"
  _ENVIRONMENT: "{{ phase1.environment }}"
  _APPLY_CHANGES: "false"

steps:
  - id: "terraform-fmt-check"
    name: "hashicorp/terraform:${_TF_VERSION}"
    args:
      - "fmt"
      - "-check"
      - "-recursive"

  - id: "terraform-init"
    name: "hashicorp/terraform:${_TF_VERSION}"
    args:
      - "init"
      - "-input=false"

  - id: "terraform-validate"
    name: "hashicorp/terraform:${_TF_VERSION}"
    args:
      - "validate"

  - id: "terraform-plan"
    name: "hashicorp/terraform:${_TF_VERSION}"
    args:
      - "plan"
      - "-input=false"
      - "-var-file=terraform.tfvars"
      - "-out=tfplan"

  - id: "terraform-apply"
    name: "hashicorp/terraform:${_TF_VERSION}"
    entrypoint: "sh"
    args:
      - "-c"
      - |
        if [ "${_APPLY_CHANGES}" = "true" ]; then
          terraform apply -input=false -auto-approve tfplan
        else
          echo "Skipping terraform apply (_APPLY_CHANGES=${_APPLY_CHANGES}). Set _APPLY_CHANGES=true to deploy."
        fi
