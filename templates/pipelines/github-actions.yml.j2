# Generated by Oracle Database@Google Cloud Onboarding & Infrastructure Agent
name: "Deploy Oracle Database@Google Cloud ({{ phase1.environment }})"

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  id-token: write
  pull-requests: write

env:
  TF_IN_AUTOMATION: "true"
  GOOGLE_PROJECT: "{{ phase1.project_id }}"
  GOOGLE_REGION: "{{ phase1.region }}"

jobs:
  terraform-plan:
    name: "Terraform Validate & Plan"
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Authenticate to Google Cloud via Workload Identity Federation
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: "{{ phase4.workload_identity_provider }}"
          service_account: "{{ phase4.terraform_service_account }}"

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "1.8.5"

      - name: Terraform Format Check
        run: terraform fmt -check -recursive

      - name: "Terraform Init (GCS Backend: {{ phase4.gcs_state_bucket }})"
        run: terraform init -input=false

      - name: Terraform Validate
        run: terraform validate

      - name: Terraform Plan
        env:
          TF_VAR_db_admin_password: ${{ "{{" }} secrets.ODB_ADMIN_PASSWORD {{ "}}" }}
        run: terraform plan -input=false -var-file=terraform.tfvars -out=tfplan

      - name: Upload Terraform Plan Artifact
        uses: actions/upload-artifact@v4
        with:
          name: tfplan-{{ phase1.environment }}
          path: tfplan
          retention-days: 5

  terraform-apply:
    name: "Terraform Apply ({{ phase1.environment }})"
    needs: terraform-plan
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    runs-on: ubuntu-latest
    environment:
      name: {{ phase1.environment }}
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Authenticate to Google Cloud via Workload Identity Federation
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: "{{ phase4.workload_identity_provider }}"
          service_account: "{{ phase4.terraform_service_account }}"

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "1.8.5"

      - name: Terraform Init
        run: terraform init -input=false

      - name: Download Terraform Plan Artifact
        uses: actions/download-artifact@v4
        with:
          name: tfplan-{{ phase1.environment }}

      - name: Terraform Apply
        env:
          TF_VAR_db_admin_password: ${{ "{{" }} secrets.ODB_ADMIN_PASSWORD {{ "}}" }}
        run: terraform apply -input=false -auto-approve tfplan
