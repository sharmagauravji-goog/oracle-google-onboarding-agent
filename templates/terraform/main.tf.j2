# Generated by Oracle Database@Google Cloud Onboarding & Infrastructure Agent
# Environment: {{ phase1.environment }} | Workload: {{ workload_type }} | Cost Center: {{ phase1.cost_center if phase1.cost_center else "N/A (Optional)" }}

check "odb_region_zone_alignment" {
  assert {
    condition     = startswith(var.gcp_oracle_zone, "${var.region}-")
    error_message = "The configured gcp_oracle_zone (${var.gcp_oracle_zone}) must belong to the target region (${var.region})."
  }
}
{% if workload_type in ["adb", "basedb"] and phase4.enable_secret_manager %}

# Optional Google Cloud Secret Manager lookup for Oracle ADMIN/SYS password
data "google_secret_manager_secret_version" "db_admin_password" {
  count   = var.use_secret_manager_for_password ? 1 : 0
  project = var.project_id
  secret  = var.secret_manager_secret_id
}

locals {
  effective_db_admin_password = (
    var.use_secret_manager_for_password
    ? data.google_secret_manager_secret_version.db_admin_password[0].secret_data
    : var.db_admin_password
  )
}
{% elif workload_type in ["adb", "basedb"] %}

locals {
  effective_db_admin_password = var.db_admin_password
}
{% endif %}

module "odb_networking" {
  source = "./modules/networking"

  project_id               = var.project_id
  network_project_id       = var.network_project_id
  region                   = var.region
  gcp_oracle_zone          = var.gcp_oracle_zone
  environment              = var.environment
  cost_center              = var.cost_center
  data_classification      = var.data_classification
  vpc_network_name         = var.vpc_network_name
  odb_network_id           = var.odb_network_id
  odb_network_display_name = var.odb_network_display_name
  client_subnet_id         = var.client_subnet_id
  client_subnet_cidr       = var.client_subnet_cidr
  backup_subnet_id         = var.backup_subnet_id
  backup_subnet_cidr       = var.backup_subnet_cidr
}
{% if workload_type == "adb" %}

module "odb_adb" {
  source = "./modules/adb"

  project_id                   = var.project_id
  region                       = var.region
  environment                  = var.environment
  cost_center                  = var.cost_center
  data_classification          = var.data_classification
  deletion_protection          = var.deletion_protection
  odb_network_name             = module.odb_networking.odb_network_name
  odb_client_subnet_name       = module.odb_networking.client_subnet_name
  instance_id                  = var.adb_instance_id
  display_name                 = var.adb_display_name
  db_name                      = var.adb_db_name
  db_workload                  = var.adb_db_workload
  db_version                   = var.adb_db_version
  compute_count                = var.adb_compute_count
  data_storage_size_tb         = var.adb_data_storage_size_tb
  is_auto_scaling_enabled      = var.adb_is_auto_scaling_enabled
  license_type                 = var.adb_license_type
  mtls_connection_required     = var.adb_mtls_connection_required
  backup_retention_period_days = var.adb_backup_retention_period_days
  is_local_data_guard_enabled  = var.adb_is_local_data_guard_enabled
  character_set                = var.adb_character_set
  ncharacter_set               = var.adb_ncharacter_set
  maintenance_schedule_type    = var.adb_maintenance_schedule_type
  db_admin_password            = local.effective_db_admin_password
}
