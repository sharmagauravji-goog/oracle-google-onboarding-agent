# ODB Networking Module (google_oracle_database_odb_network & google_oracle_database_odb_subnet)

locals {
  vpc_network_self_link = "projects/${var.network_project_id}/global/networks/${var.vpc_network_name}"
  common_labels = merge(
    {
      environment = var.environment
      managed_by  = "terraform-odb-onboarding-agent"
    },
    var.cost_center != null ? { cost_center = var.cost_center } : {},
    var.data_classification != null ? { data_classification = var.data_classification } : {}
  )
}

resource "google_oracle_database_odb_network" "this" {
  odb_network_id  = var.odb_network_id
  location        = var.region
  project         = var.project_id
  network         = local.vpc_network_self_link
  gcp_oracle_zone = var.gcp_oracle_zone
  labels          = local.common_labels
}

resource "google_oracle_database_odb_subnet" "client" {
  odb_subnet_id = var.client_subnet_id
  location      = var.region
  project       = var.project_id
  odbnetwork    = google_oracle_database_odb_network.this.id
  cidr_range    = var.client_subnet_cidr
  purpose       = "CLIENT_SUBNET"
  labels        = local.common_labels
}

resource "google_oracle_database_odb_subnet" "backup" {
  count         = var.backup_subnet_id != null && var.backup_subnet_cidr != null ? 1 : 0
  odb_subnet_id = var.backup_subnet_id
  location      = var.region
  project       = var.project_id
  odbnetwork    = google_oracle_database_odb_network.this.id
  cidr_range    = var.backup_subnet_cidr
  purpose       = "BACKUP_SUBNET"
  labels        = local.common_labels
}
