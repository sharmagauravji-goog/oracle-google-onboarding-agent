# Generated by Oracle Database@Google Cloud Onboarding & Infrastructure Agent

output "odb_network_name" {
  description = "Fully qualified resource name of the ODB Network."
  value       = module.odb_networking.odb_network_name
}

output "client_subnet_name" {
  description = "Fully qualified resource name of the ODB Client Subnet."
  value       = module.odb_networking.client_subnet_name
}

output "backup_subnet_name" {
  description = "Fully qualified resource name of the ODB Backup Subnet (if provisioned)."
  value       = module.odb_networking.backup_subnet_name
}
{% if workload_type == "adb" %}

output "autonomous_database_name" {
  description = "Fully qualified resource name of the Autonomous Database instance."
  value       = module.odb_adb.autonomous_database_name
}

output "autonomous_database_oci_url" {
  description = "OCI Console deep-link URL for the Autonomous Database instance."
  value       = module.odb_adb.oci_link
}
{% elif workload_type == "exadata_dedicated" %}

output "exadata_infrastructure_name" {
  description = "Fully qualified resource name of the Cloud Exadata Infrastructure."
  value       = module.odb_exadata_dedicated.exadata_infrastructure_name
}

output "cloud_vm_cluster_name" {
  description = "Fully qualified resource name of the Cloud VM Cluster."
  value       = module.odb_exadata_dedicated.cloud_vm_cluster_name
}
{% elif workload_type == "exascale" %}

output "exascale_storage_vault_name" {
  description = "Fully qualified resource name of the Exascale DB Storage Vault."
  value       = module.odb_exascale.exascale_storage_vault_name
}

output "exadb_vm_cluster_name" {
  description = "Fully qualified resource name of the Exascale VM Cluster."
  value       = module.odb_exascale.exadb_vm_cluster_name
}
{% elif workload_type == "basedb" %}

output "db_system_name" {
  description = "Fully qualified resource name of the Oracle Base Database System."
  value       = module.odb_basedb.db_system_name
}
{% endif %}
