# Generated by Oracle Database@Google Cloud Onboarding & Infrastructure Agent

variable "project_id" {
  description = "Google Cloud Service Project ID hosting Oracle Database@Google Cloud resources."
  type        = string
}

variable "network_project_id" {
  description = "Google Cloud Project ID hosting the VPC Network (Host Project for Shared VPC, or Service Project for Standalone)."
  type        = string
}

variable "region" {
  description = "Google Cloud region for ODB resources."
  type        = string
}

variable "gcp_oracle_zone" {
  description = "Google Cloud Oracle Zone (e.g., us-east4-b-r1)."
  type        = string
}

variable "environment" {
  description = "Deployment environment label (dev, staging, prod)."
  type        = string
}

variable "cost_center" {
  description = "Optional Enterprise FinOps cost center label applied to all provisioned resources."
  type        = string
  default     = null
}

variable "data_classification" {
  description = "Optional Enterprise data security classification label (restricted, confidential, internal, public)."
  type        = string
  default     = null
}

variable "deletion_protection" {
  description = "Enable deletion protection to guard against accidental database destruction."
  type        = bool
  default     = true
}

variable "vpc_network_name" {
  description = "Name of the existing Google Cloud VPC network."
  type        = string
}

variable "odb_network_id" {
  description = "ODB Network resource identifier."
  type        = string
}

variable "odb_network_display_name" {
  description = "Display name for the ODB Network."
  type        = string
}

variable "client_subnet_id" {
  description = "ODB Client Subnet resource identifier."
  type        = string
}

variable "client_subnet_cidr" {
  description = "CIDR block for ODB Client Subnet (minimum /28, non-overlapping with VPC)."
  type        = string
}

variable "backup_subnet_id" {
  description = "Optional ODB Backup Subnet resource identifier (required for Exadata Dedicated and Exascale)."
  type        = string
  default     = null
}

variable "backup_subnet_cidr" {
  description = "Optional CIDR block for ODB Backup Subnet (minimum /28, non-overlapping)."
  type        = string
  default     = null
}
{% if workload_type in ["adb", "basedb"] and phase4.enable_secret_manager %}

variable "use_secret_manager_for_password" {
  description = "When true, fetches the database admin password from Google Cloud Secret Manager instead of var.db_admin_password."
  type        = bool
  default     = false
}

variable "secret_manager_secret_id" {
  description = "Google Cloud Secret Manager Secret ID storing the Oracle database admin password."
  type        = string
  default     = "{{ phase4.secret_manager_secret_id }}"
}
{% endif %}
{% if workload_type == "adb" %}

variable "adb_instance_id" {
  description = "Autonomous Database Serverless resource ID."
  type        = string
}

variable "adb_display_name" {
  description = "Autonomous Database display name."
  type        = string
}

variable "adb_db_name" {
  description = "Oracle Database name (1-14 alphanumeric characters)."
  type        = string
}

variable "adb_db_workload" {
  description = "Autonomous Database workload type (OLTP, DW, APEX, AJD)."
  type        = string
}

variable "adb_db_version" {
  description = "Oracle Database version (23ai or 19c)."
  type        = string
}

variable "adb_compute_count" {
  description = "ECPU compute count."
  type        = number
}

variable "adb_data_storage_size_tb" {
  description = "Data storage size in Terabytes (TB)."
  type        = number
}

variable "adb_is_auto_scaling_enabled" {
  description = "Whether ECPU auto-scaling is enabled."
  type        = bool
}

variable "adb_license_type" {
  description = "Oracle license type (LICENSE_INCLUDED or BRING_YOUR_OWN_LICENSE)."
  type        = string
}

variable "adb_mtls_connection_required" {
  description = "Whether mutual TLS (mTLS) is required for connections."
  type        = bool
}

variable "adb_backup_retention_period_days" {
  description = "Automated backup retention period in days (1-60)."
  type        = number
  default     = 30
}

variable "adb_is_local_data_guard_enabled" {
  description = "Whether Autonomous Data Guard is enabled for high availability."
  type        = bool
  default     = true
}

variable "adb_character_set" {
  description = "Database character set (e.g., AL32UTF8)."
  type        = string
  default     = "AL32UTF8"
}

variable "adb_ncharacter_set" {
  description = "Database national character set (AL16UTF16 or UTF8)."
  type        = string
  default     = "AL16UTF16"
}

variable "adb_maintenance_schedule_type" {
  description = "Autonomous maintenance schedule type (REGULAR or EARLY)."
  type        = string
  default     = "REGULAR"
}

variable "db_admin_password" {
  description = "ADMIN user password for Autonomous Database. Pass via TF_VAR_db_admin_password or Secret Manager."
  type        = string
  sensitive   = true
  default     = null
}
